# --- API (apps/api) ---
DATABASE_URL=postgresql+asyncpg://halo:halo@localhost:5432/halo
TEST_DATABASE_URL=postgresql+asyncpg://halo:halo@localhost:5432/halo_test
JWT_SECRET=dev-only-secret-change-me-in-production-0123456789
ENV=dev
# mock | openai  (the demo runs fully on the mock provider)
LLM_PROVIDER=mock
# 1.0 = realistic streaming pace, 0 = instant
AGENT_DELAY_SCALE=1.0
# Only used when LLM_PROVIDER=openai (any OpenAI-compatible endpoint)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Web (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
