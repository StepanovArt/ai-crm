# Copy to secrets.env (git-ignored) or run `make k8s-secrets` to generate random values.
# DATABASE_URL must contain the same password as POSTGRES_PASSWORD.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://halo:change-me@postgres:5432/halo
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
# Only needed with LLM_PROVIDER=openai.
OPENAI_API_KEY=
