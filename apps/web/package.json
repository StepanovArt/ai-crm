    "@types/react-dom": "^19.1.9",
    "eslint": "^9.35.0",
    "eslint-config-next": "15.5.28",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.9.1",
    "prettier": "^3.6.2",
